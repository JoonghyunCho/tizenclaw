#!/bin/bash
# tv-key — Send virtual key events to Samsung TV via vk_send.
# Output is always JSON for TizenClaw LLM consumption.

set -eo pipefail

show_help() {
  cat <<'EOF'
{"usage": "tv-key <keycode> [--repeat N] [--delay MS]", "common_keys": {"up": 111, "down": 116, "left": 113, "right": 114, "back": 9, "prior": 112, "next": 117, "end": 115, "sys_menu": 133, "simple_menu": 135, "channel_guide": 138, "exit": 182, "info": 196, "power_off": 124, "lfd_power_off": 120, "picture_size": 140, "picture_mode": 141, "sound_mode": 197, "num_0": 19, "num_1": 10, "num_2": 11, "num_3": 12, "num_4": 13, "num_5": 14, "num_6": 15, "num_7": 16, "num_8": 17, "num_9": 18}}
EOF
  exit 0
}

# Defaults
REPEAT=1
DELAY=100
KEYCODE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --repeat) REPEAT="$2"; shift 2 ;;
    --delay) DELAY="$2"; shift 2 ;;
    --help|-h) show_help ;;
    *)
      if [ -z "$KEYCODE" ]; then
        KEYCODE="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$KEYCODE" ]; then
  echo '{"error": "No keycode provided. Usage: tv-key <keycode> [--repeat N] [--delay MS]"}'
  exit 1
fi

# Send key events
DELAY_SEC=$(echo "scale=3; $DELAY/1000" | bc 2>/dev/null || echo "0.1")
for i in $(seq 1 "$REPEAT"); do
  vk_send "$KEYCODE" 2>/dev/null
  if [ "$i" -lt "$REPEAT" ]; then
    sleep "$DELAY_SEC"
  fi
done

echo "{\"success\": true, \"keycode\": ${KEYCODE}, \"repeat\": ${REPEAT}, \"delay_ms\": ${DELAY}}"
