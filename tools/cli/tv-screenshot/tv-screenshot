#!/bin/bash
# tv-screenshot — Capture Samsung TV screen via Enlightenment.
# Output is always JSON for TizenClaw LLM consumption.

set -eo pipefail

DEFAULT_PATH="/tmp"
DEFAULT_NAME="dump_screen.png"

show_help() {
  cat <<'EOF'
{"usage": "tv-screenshot [--path DIR] [--name FILE]", "defaults": {"path": "/tmp", "name": "dump_screen.png"}}
EOF
  exit 0
}

# Parse arguments
OUT_PATH="$DEFAULT_PATH"
OUT_NAME="$DEFAULT_NAME"

while [[ $# -gt 0 ]]; do
  case $1 in
    --path) OUT_PATH="$2"; shift 2 ;;
    --name) OUT_NAME="$2"; shift 2 ;;
    --help|-h) show_help ;;
    *) shift ;;
  esac
done

OUTPUT_FILE="${OUT_PATH}/${OUT_NAME}"

# Take screenshot
enlightenment_info -dump_screen -p "$OUT_PATH" -n "$OUT_NAME" 2>/dev/null

if [ -f "$OUTPUT_FILE" ]; then
  SIZE=$(stat -c%s "$OUTPUT_FILE" 2>/dev/null || echo 0)
  echo "{\"success\": true, \"path\": \"${OUTPUT_FILE}\", \"size\": ${SIZE}}"
else
  echo "{\"success\": false, \"error\": \"Screenshot failed\"}"
  exit 1
fi
